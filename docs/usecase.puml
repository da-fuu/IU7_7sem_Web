@startuml
left to right direction
skinparam packageStyle rectangle

actor "Неавторизованный пользователь" as guest
actor "Пользователь" as user
actor "Администратор" as admin
admin -|> user

rectangle "TimeTracker" {
  usecase "Зарегистрироваться" as UC_Register
  usecase "Войти в систему" as UC_Login
  usecase "Запустить/остановить активную задачу" as UC_Timer
  usecase "Добавить запись времени вручную" as UC_Manual
  usecase "Настроить предпочтения и лимиты" as UC_ManageSettings
  usecase "Управлять личными категориями" as UC_ManageOwnCategories
  usecase "Редактировать параметры записи" as UC_UpdateRecord
  usecase "Просмотреть историю изменений записи" as UC_ViewHistory
  usecase "Откатить запись к версии" as UC_RollbackRecord
  usecase "Удалить запись времени" as UC_DeleteRecord

  usecase "Управлять базовыми категориями" as UC_ManageDefaultCategories
}

guest --> UC_Register
guest --> UC_Login

user --> UC_Timer
user --> UC_Manual
user --> UC_ManageSettings
user --> UC_ManageOwnCategories
user --> UC_UpdateRecord
user --> UC_ViewHistory
user --> UC_RollbackRecord
user --> UC_DeleteRecord

admin --> UC_ManageDefaultCategories

@enduml
