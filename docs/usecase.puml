@startuml
left to right direction
skinparam packageStyle rectangle

actor "Пользователь" as user
actor "Администратор" as admin
admin -|> user

rectangle "TimeTracker" {
  usecase "Зарегистрироваться" as UC_Register
  usecase "Войти" as UC_Login
  usecase "Запустить/остановить таймер" as UC_Timer
  usecase "Добавить запись времени вручную" as UC_Manual
  usecase "Редактировать/удалить свою запись" as UC_EditRecord
  usecase "Управлять личными категориями" as UC_ManageOwnCategories

  usecase "Управлять базовыми категориями" as UC_ManageDefaultCategories
}

user --> UC_Register
user --> UC_Login
user --> UC_Timer
user --> UC_Manual
user --> UC_EditRecord
user --> UC_ManageOwnCategories

admin --> UC_ManageDefaultCategories

@enduml
