@startuml
!include <c4/C4_Context.puml>

Person(user, "Пользователь", "Основной пользователь приложения. Отслеживает свое время, управляет своими категориями.")
Person(admin, "Администратор", "Привилегированный пользователь. Управляет глобальными базовыми категориями.")

System(time_tracker, "TimeTracker", "Мобильное приложение для учета и категоризации личного времени пользователя.")

Rel(user, time_tracker, "Отслеживает время, добавляет записи, создает и удаляет категории")
Rel(admin, time_tracker, "Создает и удаляет базовые категории")

@enduml
