@startuml
!include <c4/C4_Component.puml>

Person(user, "Пользователь", "Взаимодействует с CLI или Android UI")

ContainerDb(local_db, "Локальная БД", "SQLite (Room)", "Хранение данных")

Container_Boundary(app_container, "Система TimeTracker") {

    Component(app, "Компонент App (Android)", "Jetpack Compose, ViewModels", "Графический интерфейс для мобильных устройств.")

    Component(tech_ui, "Компонент Tech UI (CLI)", "Kotlin JVM, SLF4J-Simple", "Интерфейс командной строки для JVM и Android (app_process).")

    Component(domain, "Компонент бизнес-логики", "Kotlin UseCases, Entities", "Ядро системы: правила, валидация, интерфейсы.")

    Component(data, "Компонент доступа к данным", "Repository Pattern, Room DAO", "Доступ к данным, маппинг, реализация интерфейсов репозиториев.")
}

Rel(user, app, "Нажимает кнопки", "Touch UI")
Rel(user, tech_ui, "Вводит команды", "CLI / Bash")

Rel(app, domain, "Вызывает сценарии (Use Cases)", "Kotlin Flow / Coroutines")
Rel(tech_ui, domain, "Вызывает сценарии (Use Cases)", "Blocking / Coroutines")

Rel(data, domain, "Реализует интерфейсы репозиториев", "Implements")
Rel(data, local_db, "Выполняет SQL-запросы", "Room KMP / SQLite")

@enduml
