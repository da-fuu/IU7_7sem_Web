@startuml
skinparam classAttributeIconSize 0
skinparam linetype ortho

package "Бизнес-логика (Domain)" #E8F5E9 {

    class User <<Entity>> {
        - id: UserId
        - login: String
        - name: String
        - passwordHash: String
        - role: UserRole
    }

    class UserSettings <<Entity>> {
        - id: SettingsId
        - userId: UserId
        - durationUnit: DurationUnit
        - autoStopEnabled: Boolean
        - maxActiveDurationValue: Long
        - maxActiveDurationUnit: DurationUnit
        - minDurationEnabled: Boolean
        - minDurationValue: Long
        - minDurationUnit: DurationUnit
    }

    class Category <<Entity>> {
        - id: CategoryId
        - userId: UserId?
        - name: String
        - colorHex: String
        - isDefault: Boolean
    }

    class TimeRecord <<Entity>> {
        - id: RecordId
        - userId: UserId
        - categoryId: CategoryId
        - startTime: Instant
        - endTime: Instant?
        - description: String
        + getDurationMinutes(): Long
    }

    class RecordHistoryEntry <<Entity>> {
        - id: HistoryId
        - recordId: RecordId
        - categoryId: CategoryId
        - startTime: Instant
        - endTime: Instant?
        - description: String
        - modifiedAt: Instant
    }

    enum DurationUnit <<Enum>> {
        SECONDS
        MINUTES
        HOURS
        DAYS
        + toSeconds(value: Long): Long
    }

    interface IUserRepository <<Interface>> {
        + suspend findByLogin(login: String): User?
        + suspend saveUser(user: User): Result<Unit>
        + suspend getUserRole(userId: UserId): UserRole?
        + suspend getUserById(userId: UserId): User?
        + suspend getAllUsers(): List<User>
    }

    interface IUserSettingsRepository <<Interface>> {
        + suspend getSettingsByUserId(userId: UserId): UserSettings?
        + suspend saveSettings(settings: UserSettings): Result<Unit>
    }

    interface ITimeRecordRepository <<Interface>> {
        + suspend saveRecord(record: TimeRecord): Result<Unit>
        + suspend getRecordById(recordId: RecordId): TimeRecord?
        + suspend getActiveRecords(userId: UserId): List<TimeRecord>
        + suspend getTimeRecords(userId: UserId): List<TimeRecord>
        + suspend deleteRecord(recordId: RecordId): Result<Unit>
        + suspend getAllTimeRecords(): List<TimeRecord>
    }

    interface IRecordHistoryRepository <<Interface>> {
        + suspend addHistoryEntry(entry: RecordHistoryEntry): Result<Unit>
        + suspend getHistoryForRecord(recordId: RecordId): List<RecordHistoryEntry>
        + suspend getHistoryEntryById(historyId: HistoryId): RecordHistoryEntry?
    }

    interface ICategoryRepository <<Interface>> {
        + getCategoriesFlow(userId: UserId): Flow<List<Category>>
        + suspend saveCategory(category: Category): Result<Unit>
        + suspend findCategoryByName(name: String, userId: UserId?): Category?
        + suspend deleteCategory(categoryId: CategoryId): Result<Unit>
        + suspend getAllCategories(): List<Category>
    }

    interface IPasswordHasher <<Interface>> {
        + hash(raw: String): String
        + verify(raw: String, hashed: String): Boolean
    }

    package "Сценарии (Use Cases)" #FFFFFF {
        class RegisterUserUseCase <<UseCase>>
        class LoginUserUseCase <<UseCase>>
        class ManageUserSettingsUseCase <<UseCase>>
        class CreateTimeRecordUseCase <<UseCase>>
        class UpdateTimeRecordUseCase <<UseCase>>
        class RollbackRecordHistoryUseCase <<UseCase>>
        class GetRecordHistoryUseCase <<UseCase>>
        class AutoStopExpiredRecordsUseCase <<UseCase>>
        class DeleteRecordUseCase <<UseCase>>
        class GetCategoriesUseCase <<UseCase>>
        class ManageUserCategoryUseCase <<UseCase>>
        class DeleteCategoryUseCase <<UseCase>>
        class AdminManageBaseCategoryUseCase <<UseCase>>
        class AdminDeleteBaseCategoryUseCase <<UseCase>>
    }

    User "1" <-- "1" UserSettings : "Имеет настройки"
    User "1" <-- "*" Category : "Владеет"
    User "1" <-- "*" TimeRecord : "Владеет"
    Category "1" <-- "*" TimeRecord : "Относится к"
    TimeRecord "1" <-- "*" RecordHistoryEntry : "Имеет историю"
    Category "1" <-- "*" RecordHistoryEntry : "Фиксирует"

    RegisterUserUseCase o--> IUserRepository
    RegisterUserUseCase o--> IUserSettingsRepository
    RegisterUserUseCase o--> IPasswordHasher

    LoginUserUseCase o--> IUserRepository
    LoginUserUseCase o--> IPasswordHasher

    ManageUserSettingsUseCase o--> IUserSettingsRepository

    CreateTimeRecordUseCase o--> ITimeRecordRepository
    CreateTimeRecordUseCase o--> IUserSettingsRepository

    UpdateTimeRecordUseCase o--> ITimeRecordRepository
    UpdateTimeRecordUseCase o--> IRecordHistoryRepository
    UpdateTimeRecordUseCase o--> IUserSettingsRepository

    RollbackRecordHistoryUseCase o--> ITimeRecordRepository
    RollbackRecordHistoryUseCase o--> IRecordHistoryRepository

    GetRecordHistoryUseCase o--> ITimeRecordRepository
    GetRecordHistoryUseCase o--> IRecordHistoryRepository

    AutoStopExpiredRecordsUseCase o--> ITimeRecordRepository
    AutoStopExpiredRecordsUseCase o--> IUserSettingsRepository
    AutoStopExpiredRecordsUseCase o--> IRecordHistoryRepository

    DeleteRecordUseCase o--> ITimeRecordRepository

    GetCategoriesUseCase o--> ICategoryRepository
    ManageUserCategoryUseCase o--> ICategoryRepository
    DeleteCategoryUseCase o--> ICategoryRepository
    AdminManageBaseCategoryUseCase o--> ICategoryRepository
    AdminManageBaseCategoryUseCase o--> IUserRepository
    AdminDeleteBaseCategoryUseCase o--> ICategoryRepository
    AdminDeleteBaseCategoryUseCase o--> IUserRepository
}

@enduml
