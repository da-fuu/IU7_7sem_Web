@startuml
!include <c4/C4_Component.puml>

Container_Boundary(web_backend, "Web Backend API (Ktor / Clean Architecture)") {
    Component(routing, "Routing & HTTP Controllers", "Ktor Routing, Jackson", "Обрабатывает HTTP маршруты (/api/v1/auth, /users, /categories, /records), сериализует DTO, Swagger UI.")
    Component(auth_security, "Auth & Security Service", "JWT / PasswordHasher", "Проверяет токены, хэширует пароли, контролирует права ролей USER/ADMIN.")
    Component(auto_stop_worker, "Auto-Stop Background Worker", "Coroutine Worker", "Периодически останавливает активные задачи, превысившие maxActiveDuration.")
    Component(domain_core, "Domain Core (Use Cases)", "com.ppo.domain.usecase.*", "Бизнес-сценарии: CreateTimeRecord, UpdateTimeRecord, RollbackRecordHistory, AutoStop, ManageUserSettings, Categories.")
    Component(repo_interfaces, "Repository Interfaces", "com.ppo.domain.repository.*", "Интерфейсы: IUserRepository, IUserSettingsRepository, ICategoryRepository, ITimeRecordRepository, IRecordHistoryRepository.")
    Component(db_postgres, "PostgreSQL Data Repositories (:web:data)", "Exposed ORM / HikariCP", "Реализация репозиториев для серверной СУБД PostgreSQL на базе Exposed ORM.")
    Component(db_room, "SQLite / Room Repositories (:data)", "Room DAO", "Сохраненный адаптер доступа к локальной SQLite для легаси клиентов.")
}

Rel(routing, auth_security, "Аутентифицирует запросы", "Internal")
Rel(routing, domain_core, "Вызывает сценарии бизнес-логики", "Kotlin Coroutines")
Rel(auto_stop_worker, domain_core, "Запускает периодическую авто-остановку", "AutoStopExpiredRecordsUseCase")
Rel(domain_core, repo_interfaces, "Использует интерфейсы репозиториев", "Interfaces")
Rel(db_postgres, repo_interfaces, "Реализует", "Implements")
Rel(db_room, repo_interfaces, "Реализует", "Implements")

@enduml
