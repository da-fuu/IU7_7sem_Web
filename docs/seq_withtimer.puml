@startuml
autonumber
skinparam maxMessageSize 150
skinparam ParticipantPadding 20

actor "Пользователь" as user
boundary "TimerScreen\n(UI Compose)" as ui
control "TimerViewModel\n(Presentation)" as vm
control "TimeRecordUseCases\n(Domain)" as uc
database "UserSettingsRepository\n(Data)" as settingsRepo
database "TimeRecordRepository\n(Data)" as repo

user -> ui : Открывает вкладку Таймер
activate ui

ui -> vm : Запрос текущих активных задач
activate vm
vm -> repo : getActiveRecords(userId)
activate repo
repo --> vm : List<TimeRecord> (активные сессии с endTime=null)
deactivate repo
vm --> ui : UI State (Активные таймеры)
deactivate vm

user -> ui : Выбирает категорию, жмет "Старт"
ui -> vm : startActiveRecord(categoryId, description)
activate vm

vm -> uc : CreateTimeRecordUseCase(start=now, end=null)
activate uc
uc -> repo : saveRecord(openTimeRecord)
activate repo
repo --> uc : Success (RecordId)
deactivate repo
uc --> vm : Success
deactivate uc

vm --> ui : UI State (Таймер запущен в фоне, параллельные задачи разрешены)
deactivate vm

...Проходит некоторое время активности...

user -> ui : Жмет "Стоп"
ui -> vm : stopActiveRecord(recordId, end=now)
activate vm

vm -> uc : UpdateTimeRecordUseCase(recordId, end=now)
activate uc

uc -> settingsRepo : getSettingsByUserId(userId)
activate settingsRepo
settingsRepo --> uc : UserSettings
deactivate settingsRepo

uc -> uc : Проверка длительности (now - start) по minDuration

alt #mistyrose Если minDurationEnabled и длительность < minDuration
    uc --> vm : Error("422 DURATION_TOO_SHORT")
    vm --> ui : Предупреждение о слишком короткой длительности
    ui --> user : Видит ошибку, сессия продолжается
else #honeydew Длительность валидна (или проверка отключена)
    uc -> repo : saveRecord(updatedTimeRecord)
    activate repo
    repo --> uc : Success
    deactivate repo
    uc --> vm : Success
    deactivate uc
    vm --> ui : Обновить список и статистику
    deactivate vm
    ui --> user : Задача успешно завершена и зафиксирована
end

deactivate ui
@enduml
