@startchen

entity Пользователь {
  Идентификатор
  Логин
  Имя
  Хэш_пароля
  Роль
}

entity Категория {
  Идентификатор
  Имя
  Цвет
  Тип_категории
}

entity Запись_времени {
  Идентификатор
  Время_начала
  Время_окончания
  Описание
}

entity Версия_описания {
  Идентификатор
  Описание
  Время_изменения
}

relationship Создает {
}

relationship Логирует {
}

relationship Включает {
}

relationship Хранит {
}

Пользователь -1- Создает
Создает -N- Категория

Пользователь -1- Логирует
Логирует -N- Запись_времени

Категория -1- Включает
Включает -N- Запись_времени

Запись_времени -1- Хранит
Хранит -N- Версия_описания

@endchen
