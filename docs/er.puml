@startchen

entity Пользователь {
  Идентификатор
  Имя
  Email
  Хэш_пароля
  Роль
}

entity Категория {
  Идентификатор
  Название
  Цвета
  Тип_категории
}

entity Запись_времени {
  Идентификатор
  Время_начала
  Время_окончания
  Описание
}

entity Стат_отчет {
  Идентификатор
  Дата_начала
  Дата_конца
  Суммарное_время
  Тип_отчета
}

relationship Создает {
}

relationship Логирует {
}

relationship Запрашивает {
}

relationship Включает {
}

relationship Агрегирует {
}

Пользователь -1- Создает
Создает -N- Категория

Пользователь -1- Логирует
Логирует -N- Запись_времени

Пользователь -1- Запрашивает
Запрашивает -N- Стат_отчет

Категория -1- Включает
Включает -N- Запись_времени

Стат_отчет -1- Агрегирует
Агрегирует -N- Запись_времени

@endchen
