@startuml

entity "Пользователь" as user {
  * Идентификатор
  --
  * Имя
  * Email
  * Хэш пароля
  * Роль
}

entity "Категория" as category {
  * Идентификатор
  --
  * Название
  * Цвета
  * Тип (базовая или нет)
}

entity "Запись времени" as record {
  * Идентификатор
  --
  * Время и дата начала
  * Время и дата окончания
  * Описание (заметка)
}

entity "Статистический отчет" as report {
  * Идентификатор
  --
  * Дата начала периода
  * Дата конца периода
  * Суммарное затраченное время
  * Тип (день/неделя/месяц)
}

user ||--o{ category : "создает"
user ||--o{ record : "логирует"
user ||--o{ report : "запрашивает"

category ||--o{ record : "включает"
report ||--o{ record : "агрегирует"

@enduml
