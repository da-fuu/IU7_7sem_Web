@startuml
skinparam linetype ortho
skinparam packageStyle rectangle

entity "Пользователь" as user {
  * id : UUID <<PK>>
  --
  * login : String
  * name : String
  * password_hash : String
  * role : Role (USER/ADMIN)
}

entity "Настройки_пользователя" as settings {
  * id : UUID <<PK>>
  --
  * user_id : UUID <<FK>>
  * duration_unit : DurationUnit
  * auto_stop_enabled : Boolean
  * max_active_duration : Long
  * min_duration_enabled : Boolean
  * min_duration : Long
}

entity "Категория" as category {
  * id : UUID <<PK>>
  --
  user_id : UUID <<FK>>
  * name : String
  * color_hex : String
  * is_default : Boolean
}

entity "Запись_времени" as record {
  * id : UUID <<PK>>
  --
  * user_id : UUID <<FK>>
  * category_id : UUID <<FK>>
  * start_time : Timestamp
  end_time : Timestamp?
  * description : String
}

entity "Снимок_истории_записи" as history {
  * id : UUID <<PK>>
  --
  * record_id : UUID <<FK>>
  * category_id : UUID <<FK>>
  * start_time : Timestamp
  end_time : Timestamp?
  * description : String
  * modified_at : Timestamp
}

user ||--|| settings : "Настраивает"
user ||--o{ category : "Создает"
user ||--o{ record : "Логирует"
category ||--o{ record : "Включает"
record ||--o{ history : "Хранит снимки"
category ||--o{ history : "Фиксирует категорию"

@enduml
