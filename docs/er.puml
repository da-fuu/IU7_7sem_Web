@startchen

entity Пользователь {
  Идентификатор
  Логин
  Имя
  Хэш_пароля
  Роль
}

entity Настройки_пользователя {
  Идентификатор
  Единица_измерения
  Авто_остановка_включена
  Макс_длительность
  Мин_длительность_включена
  Мин_длительность
}

entity Категория {
  Идентификатор
  Имя
  Цвет
  Тип_категории
}

entity Запись_времени {
  Идентификатор
  Время_начала
  Время_окончания
  Описание
}

entity Снимок_истории_записи {
  Идентификатор
  Время_начала
  Время_окончания
  Описание
  Время_изменения
}

relationship Настраивает {
}

relationship Создает {
}

relationship Логирует {
}

relationship Включает {
}

relationship Хранит {
}

relationship Фиксирует_категорию {
}

Пользователь -1- Настраивает
Настраивает -1- Настройки_пользователя

Пользователь -1- Создает
Создает -N- Категория

Пользователь -1- Логирует
Логирует -N- Запись_времени

Категория -1- Включает
Включает -N- Запись_времени

Запись_времени -1- Хранит
Хранит -N- Снимок_истории_записи

Категория -1- Фиксирует_категорию
Фиксирует_категорию -N- Снимок_истории_записи

@endchen
