@startuml
!include <c4/C4_Container.puml>

Person(user, "Пользователь / Администратор", "Пользователи системы")

System_Boundary(time_tracker_system, "TimeTracker") {

    Container(app, "Android Приложение (App)", "Kotlin, Jetpack Compose", "Обеспечивает графический интерфейс для мобильных устройств.")

    Container(tech_ui, "Технологический UI (CLI)", "Kotlin JVM", "Обеспечивает консольный интерфейс на ПК и Android.")

    ContainerDb(local_db, "Локальная БД", "SQLite (Room)", "Хранит категории, записи времени и настройки пользователя.")
}

Rel(user, app, "Взаимодействует с GUI", "Android UI")
Rel(user, tech_ui, "Вводит команды", "CLI")

Rel(app, local_db, "Читает и записывает данные", "SQL / Room")
Rel(tech_ui, local_db, "Читает и записывает данные", "SQL / Room")

@enduml
