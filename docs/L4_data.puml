@startuml
skinparam classAttributeIconSize 0
skinparam linetype ortho

interface "Domain::ITimeRecordRepository" as ITimeRecordRepository <<Interface>> #LightGray
class "Domain::TimeRecord" as TimeRecord <<Entity>> #LightGray
class "Domain::RecordHistoryEntry" as RecordHistoryEntry <<Entity>> #LightGray

package "Доступ к данным" #FFF3E0 {
    class TimeRecordEntity <<Database Entity>> {
        - uid: String
        - user_id: String
        - category_id: String
        - start_time: Instant
        - end_time: Instant?
        - description: String
    }

    class TimeRecordHistoryEntity <<Database Entity>> {
        - uid: String
        - record_id: String
        - category_id: String
        - start_time: Instant
        - end_time: Instant?
        - description: String
        - modified_at: Instant
    }

    interface TimeRecordDao <<Room DAO>> {
        + suspend insert(entity: TimeRecordEntity): Long
        + suspend update(entity: TimeRecordEntity): Int
        + suspend getById(recordId: String): TimeRecordEntity?
        + suspend getActiveSession(userId: String): TimeRecordEntity?
        + suspend getAllByUserId(userId: String): List<TimeRecordEntity>
        + suspend deleteById(recordId: String): Int
    }

    interface TimeRecordHistoryDao <<Room DAO>> {
        + suspend insert(entity: TimeRecordHistoryEntity)
        + suspend getByRecordId(recordId: String): List<TimeRecordHistoryEntity>
    }

    abstract class AppDatabase <<RoomDatabase>> {
        + userDao(): UserDao
        + categoryDao(): CategoryDao
        + timeRecordDao(): TimeRecordDao
        + timeRecordHistoryDao(): TimeRecordHistoryDao
    }

    class TimeRecordMapper <<Mapper>> {
        + toDomain(entity: TimeRecordEntity): TimeRecord
        + toEntity(domain: TimeRecord): TimeRecordEntity
        + historyToDomain(entity: TimeRecordHistoryEntity): RecordHistoryEntry
        + historyToEntity(domain: RecordHistoryEntry): TimeRecordHistoryEntity
    }

    class TimeRecordRepositoryImpl <<Repository>> {
        - dao: TimeRecordDao
        - historyDao: TimeRecordHistoryDao
        + suspend saveRecord(record: TimeRecord): Result<Unit>
        + suspend getRecordById(recordId: RecordId): TimeRecord?
        + suspend getActiveRecords(userId: UserId): List<TimeRecord>
        + suspend getTimeRecords(userId: UserId): List<TimeRecord>
        + suspend deleteRecord(recordId: RecordId): Result<Unit>
        + suspend getAllTimeRecords(): List<TimeRecord>
    }

    interface SQLiteDriver <<Interface>> #LightGray

    class BundledSQLiteDriver <<Driver>> #FFE0B2
    class FrameworkSQLiteDriver <<Driver>> #FFE0B2

    TimeRecordRepositoryImpl ..|> ITimeRecordRepository
    TimeRecordRepositoryImpl o--> TimeRecordDao
    TimeRecordRepositoryImpl o--> TimeRecordHistoryDao
    TimeRecordRepositoryImpl o--> TimeRecordMapper
    AppDatabase *--> TimeRecordDao
    AppDatabase *--> TimeRecordHistoryDao

    TimeRecordDao ..> TimeRecordEntity
    TimeRecordHistoryDao ..> TimeRecordHistoryEntity
    TimeRecordMapper ..> TimeRecordEntity
    TimeRecordMapper ..> TimeRecordHistoryEntity
    TimeRecordMapper ..> TimeRecord
    TimeRecordMapper ..> RecordHistoryEntry

    AppDatabase ..> SQLiteDriver
    SQLiteDriver <|.. BundledSQLiteDriver
    SQLiteDriver <|.. FrameworkSQLiteDriver
}

@enduml
