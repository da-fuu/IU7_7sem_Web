@startuml
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 60

package "Бизнес-логика" #E8F5E9 {

    class User <<Entity>> {
        - id: UserId
        - login: String
        - name: String
        - passwordHash: String
        - role: UserRole
    }

    class Category <<Entity>> {
        - id: CategoryId
        - userId: UserId?
        - name: String
        - colorHex: String
        - isDefault: Boolean
    }

    class TimeRecord <<Entity>> {
        - id: RecordId
        - userId: UserId
        - categoryId: CategoryId
        - startTime: Instant
        - endTime: Instant?
        - description: String
        + getDurationMinutes(): Long
    }

    interface IUserRepository <<Interface>> {
        + suspend findByLogin(login: String): User?
        + suspend saveUser(user: User): Result<Unit>
        + suspend getUserRole(userId: UserId): UserRole?
    }

    interface ITimeRecordRepository <<Interface>> {
        + suspend saveRecord(record: TimeRecord): Result<Unit>
        + suspend getOverlappingRecords(...): List<TimeRecord>
        + suspend getActiveSession(userId: UserId): TimeRecord?
        + suspend getTimeRecords(userId: UserId): List<TimeRecord>
        + suspend deleteRecord(recordId: RecordId): Result<Unit>
    }

    interface ICategoryRepository <<Interface>> {
        + getCategoriesFlow(userId: UserId): Flow<List<Category>>
        + suspend saveCategory(category: Category): Result<Unit>
        + suspend findCategoryByName(...): Category?
        + suspend deleteCategory(categoryId: CategoryId): Result<Unit>
    }

    interface IPasswordHasher <<Interface>> {
        + hash(raw: String): String
        + verify(raw: String, hashed: String): Boolean
    }

    package "Use Cases" #FFFFFF {
        class RegisterUserUseCase <<UseCase>>
        class LoginUserUseCase <<UseCase>>
        class StartTimerUseCase <<UseCase>>
        class StopTimerUseCase <<UseCase>>
        class AddManualRecordUseCase <<UseCase>>
        class EditTimeRecordUseCase <<UseCase>>
        class GetCategoriesUseCase <<UseCase>>
        class GetTimeRecordsUseCase <<UseCase>>
        class ManageUserCategoryUseCase <<UseCase>>
        class DeleteCategoryUseCase <<UseCase>>
        class AdminManageBaseCategoryUseCase <<UseCase>>
        class AdminDeleteBaseCategoryUseCase <<UseCase>>
    }

    User "1" <-- "*" Category : "Владеет"
    User "1" <-- "*" TimeRecord : "Владеет"
    Category "1" <-- "*" TimeRecord : "Относится к"

    RegisterUserUseCase o--> IUserRepository
    RegisterUserUseCase o--> IPasswordHasher
    LoginUserUseCase o--> IUserRepository
    LoginUserUseCase o--> IPasswordHasher

    StartTimerUseCase o--> ITimeRecordRepository
    StopTimerUseCase o--> ITimeRecordRepository
    AddManualRecordUseCase o--> ITimeRecordRepository
    EditTimeRecordUseCase o--> ITimeRecordRepository
    GetTimeRecordsUseCase o--> ITimeRecordRepository

    GetCategoriesUseCase o--> ICategoryRepository
    ManageUserCategoryUseCase o--> ICategoryRepository
    DeleteCategoryUseCase o--> ICategoryRepository
    AdminManageBaseCategoryUseCase o--> ICategoryRepository
    AdminManageBaseCategoryUseCase o--> IUserRepository
    AdminDeleteBaseCategoryUseCase o--> ICategoryRepository
    AdminDeleteBaseCategoryUseCase o--> IUserRepository
}

@enduml
